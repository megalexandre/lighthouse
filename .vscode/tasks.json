{
  // Tasks for lighthouse/. Run with "Tasks: Run Task", or as a
  // preLaunchTask from launch.json. Ctrl+Shift+B lists the build tasks
  // (release build, AppImage, APK, generated code).
  "version": "2.0.0",
  "options": { "cwd": "${workspaceFolder}/lighthouse" },
  "tasks": [
    {
      // The release app: build/linux/x64/release/bundle/lighthouse.
      "label": "lighthouse: build (release)",
      "type": "shell",
      // Waits for any other Flutter Linux build (see tool/with_build_lock.sh).
      "command": "tool/with_build_lock.sh flutter build linux --release",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Build, then pack it as build/Lighthouse-<version>-x86_64.AppImage
      // (see lighthouse/tool/build_appimage.sh).
      "label": "lighthouse: AppImage",
      "type": "shell",
      "command": "tool/build_appimage.sh",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // The phone app (arm64): build/app/outputs/flutter-apk/app-release.apk,
      // signed with Flutter's debug key for now (see lighthouse/README.md,
      // "Android"). No build lock: it does not touch linux/flutter/ephemeral/.
      "label": "lighthouse: APK (release)",
      "type": "shell",
      "command": "flutter build apk --release --target-platform android-arm64",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Regenerates the freezed / json_serializable files after a model change.
      "label": "lighthouse: generate code",
      "type": "shell",
      "command": "dart run build_runner build --delete-conflicting-outputs",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Everything: format, analyze, unit / widget, server and integration
      // tests (see lighthouse/tool/check.sh).
      "label": "lighthouse: check (all tests)",
      "type": "shell",
      "command": "tool/check.sh",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Unit and widget tests only: fast, no server needed.
      "label": "lighthouse: unit tests",
      "type": "shell",
      "command": "flutter test --exclude-tags server",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Behaviour scenarios (test/**/*.feature): makes their tests from the
      // .feature files, then runs every one. See tool/scenarios.sh.
      "label": "lighthouse: scenarios (all features)",
      "type": "shell",
      "command": "tool/scenarios.sh",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // The feature open in the editor (its .feature, its _test.dart or one
      // of its steps); asks for part of a scenario's name, empty for all.
      "label": "lighthouse: scenarios (this feature)",
      "type": "shell",
      "command": "tool/scenarios.sh",
      "args": ["${file}", "${input:scenarioName}"],
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Keeps the tests in step with the .feature files while you write
      // them (and makes the stub of a new step). Stop it with the trash
      // icon of its terminal.
      "label": "lighthouse: scenarios (regenerate on save)",
      "type": "shell",
      "command": "dart run build_runner watch --delete-conflicting-outputs",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Integration tests on the release-like (AOT) build, headless.
      "label": "lighthouse: integration tests (profile)",
      "type": "shell",
      "command": "tool/profile_test.sh",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      // Waits for the dev server and finishes its setup if it was never
      // done (user dev / dev, libraries over /media). Changes nothing on an
      // already set-up server. See lighthouse/tool/dev_server.sh.
      "label": "lighthouse: prepare dev server",
      "type": "shell",
      "command": "tool/dev_server.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
    }
,
    {
      // The Android emulator in the container; returns once it has booted,
      // at once when it is already up. See lighthouse/tool/emulator.sh.
      "label": "lighthouse: start emulator",
      "type": "shell",
      "command": "tool/emulator.sh",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
    },
    {
      "label": "lighthouse: stop emulator",
      "type": "shell",
      "command": "tool/emulator.sh stop",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "dedicated", "clear": true }
    },
    {
      "label": "lighthouse: start emulator and dev server",
      "dependsOn": ["lighthouse: start emulator", "lighthouse: prepare dev server"],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "scenarioName",
      "type": "promptString",
      "description": "Scenarios whose name has (empty: all of the feature)",
      "default": ""
    }
  ]
}
