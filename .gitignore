# The reference repositories (jellyfin, jellyfin-desktop) are separate git
# repositories, cloned and updated by .devcontainer/related_repos.sh.
/related-repos/
# Their old place at the root, until related_repos.sh moves them.
/jellyfin/
/jellyfin-desktop/

# Generated by .devcontainer/initialize.sh with your local user ids.
.devcontainer/.env
# Your API keys (template: .devcontainer/secrets.env.example).
.devcontainer/secrets.env
